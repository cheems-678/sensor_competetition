# compile gcc flags
ASFLAGS = $(MCU) $(AS_DEFS) $(AS_INCLUDES) $(OPT) -Wall -fdata-sections -ffunction-sections

# ★ 2026-10-03: 加 -fmerge-all-constants —— 把内容相同的字符串/常量合并成一份,
#   零风险, 通常能再抠出几百字节 Flash。
CFLAGS = $(MCU) $(C_DEFS) $(C_INCLUDES) $(OPT) -Wall -fdata-sections -ffunction-sections -fmerge-all-constants

# ★ 2026-10-03: 页面改成分页版后涨到 25406 字节(64KB Flash 的 39%), 为留余量开 LTO。
#   -flto: 链接时优化, 跨文件内联+去重(这类 SPL 工程典型省 5~10% 代码);
#   -fno-*-unwind-tables: 去掉 .ARM.exidx 展开表(裸机无异常/无栈回溯, 用不到)。
#   注意: -flto 必须编译侧和链接侧都加, 只加一侧会报 lto 相关错。
#   还原: python _patch_link_flto.py --revert
CFLAGS += -flto -fno-unwind-tables -fno-asynchronous-unwind-tables

ifeq ($(DEBUG), 1)
CFLAGS += -g -gdwarf-2
CFLAGS+=-std=c11
endif


# Generate dependency information
CFLAGS += -MMD -MP -MF"$(@:%.o=%.d)"


#######################################
# LDFLAGS
#######################################
# link script
LDSCRIPT = STM32F103C8Tx_FLASH.ld

# libraries
# ★ 2026-10-03: 去掉 -u _printf_float / -u _scanf_float —— 这是**链接器强制**开关,
#   会把 newlib 的浮点格式化整套(转换表 + 路由)无条件链进 FLASH, 即便一个 %f 都没用。
#   实测本固件 main.c 全程走自研 u1_print / s_dec 整数路径, 一处浮点打印都没有
#   (唯一浮点是声学层的 expf(), 走 libm, 不受影响) => 这一条白占了 6~8K Flash。
#   若以后有人在主固件里用 printf("%f"), 链接会直接报 unresolved __printf_float,
#   届时把这一行改回去即可。
LIBS = -lc -lm -lnosys
LIBDIR = 
LDFLAGS = $(MCU) -specs=nano.specs -T$(LDSCRIPT) $(LIBDIR) $(LIBS) -Wl,-Map=$(BUILD_DIR)/$(TARGET).map,--cref -Wl,--gc-sections
LDFLAGS += -Wl,--no-warn-rwx-segments
LDFLAGS += -flto

# default action: build all
all: $(BUILD_DIR)/$(TARGET).elf $(BUILD_DIR)/$(TARGET).hex $(BUILD_DIR)/$(TARGET).bin


#######################################
# build the application
#######################################
# list of objects
OBJECTS = $(addprefix $(BUILD_DIR)/,$(notdir $(C_SOURCES:.c=.o)))
vpath %.c $(sort $(dir $(C_SOURCES)))
# list of ASM program objects
OBJECTS += $(addprefix $(BUILD_DIR)/,$(notdir $(ASM_SOURCES:.s=.o)))
vpath %.s $(sort $(dir $(ASM_SOURCES)))

$(BUILD_DIR)/%.o: %.c Makefile | $(BUILD_DIR) 
	@echo build $@
	@$(CC) -c $(CFLAGS) -Wa,-a,-ad,-alms=$(BUILD_DIR)/$(notdir $(<:.c=.lst)) $< -o $@

# ★★ 2026-10-03 平台实测: -flto 会把 syscalls.c / sysmem.c 里的 newlib 系统调用桩
#    (_write/_fstat/_isatty/_sbrk …) 当死代码删掉 —— 这些桩**只被非 LTO 的 libc_nano.a
#    内部引用**, LTO 的跨模块分析看不到那个引用。症状:
#        libc_nano.a(libc_a-fstatr.o): undefined reference to `_fstat'
#        libc_nano.a(libc_a-isattyr.o): undefined reference to `_isatty'
#    修法: 这两个文件单独关掉 LTO（显式规则优先于上面的 pattern 规则）。
#    ★ $(filter-out -flto,$(CFLAGS)) 必须写在**配方里**: CFLAGS 是递归变量, 若在解析期
#      用 := 取值, 里面的 $(@:%.o=%.d) 会当场展开成空, 依赖文件就废了。
$(BUILD_DIR)/syscalls.o: USER/syscalls.c Makefile | $(BUILD_DIR)
	@echo build $@ '(no-lto)'
	@$(CC) -c $(filter-out -flto,$(CFLAGS)) -Wa,-a,-ad,-alms=$(BUILD_DIR)/syscalls.lst $< -o $@

$(BUILD_DIR)/sysmem.o: USER/sysmem.c Makefile | $(BUILD_DIR)
	@echo build $@ '(no-lto)'
	@$(CC) -c $(filter-out -flto,$(CFLAGS)) -Wa,-a,-ad,-alms=$(BUILD_DIR)/sysmem.lst $< -o $@


$(BUILD_DIR)/%.o: %.s Makefile | $(BUILD_DIR)
	@echo build $@
	@$(AS) -c $(CFLAGS) $< -o $@

$(BUILD_DIR)/$(TARGET).elf: $(OBJECTS) Makefile
	@echo build $@
	@$(CC) $(OBJECTS) $(LDFLAGS) -o $@
	@$(SZ) $@

$(BUILD_DIR)/%.hex: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	$(HEX) $< $@
	
$(BUILD_DIR)/%.bin: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	$(BIN) $< $@	
	
$(BUILD_DIR):
	mkdir $@		

#######################################
clean:
	-rm -fR $(BUILD_DIR)
